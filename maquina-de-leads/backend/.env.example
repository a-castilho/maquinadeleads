# --- Servidor ---
PORT=4000
# Gere uma chave aleatoria com 32+ caracteres. Ex.: openssl rand -hex 32
JWT_SECRET=troque_por_uma_chave_aleatoria_com_32_ou_mais_caracteres
JWT_EXPIRES_IN=7d

# --- Postgres ---
DATABASE_URL=postgres://usuario:senha@localhost:5432/maquina_de_leads
PGSSL=false

# --- n8n (integracao legada enquanto a orquestracao nativa e migrada) ---
N8N_BASE_URL=https://seu-n8n.exemplo.com
N8N_API_KEY=coloque_a_api_key_do_n8n_aqui

# --- Docker Compose local ---
POSTGRES_USER=leads_user
POSTGRES_PASSWORD=troque_por_uma_senha_forte
POSTGRES_DB=maquina_de_leads
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=troque_por_uma_senha_forte

# --- CORS ---
FRONTEND_URL=http://localhost:5173

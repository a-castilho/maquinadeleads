# --- Servidor ---
PORT=4000
# Gere uma chave aleatoria com 32+ caracteres. Ex.: openssl rand -hex 32
JWT_SECRET=troque_por_uma_chave_aleatoria_com_32_ou_mais_caracteres
JWT_EXPIRES_IN=7d

# --- Postgres ---
DATABASE_URL=postgres://leads_user:troque_por_uma_senha_forte@localhost:5432/maquina_de_leads
PGSSL=false
POSTGRES_USER=leads_user
POSTGRES_PASSWORD=troque_por_uma_senha_forte
POSTGRES_DB=maquina_de_leads

# --- CORS / frontend ---
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:4000/api


# Docker Compose - Máquina de Leads

POSTGRES_USER=leads_user
POSTGRES_PASSWORD=troque_por_uma_senha_forte
POSTGRES_DB=maquina_de_leads
POSTGRES_PORT=5432

JWT_SECRET=troque_por_uma_chave_grande_e_aleatoria
JWT_EXPIRES_IN=7d

BACKEND_PORT=4000
FRONTEND_PORT=5174

# Opcional: serviço de busca Python rodando no host.
# Exemplo para Docker Desktop/Linux com extra_hosts configurado:
# ROBO_PYTHON_URL=http://host.docker.internal:8000
ROBO_PYTHON_URL=

DISCOVERY_HTTP_TIMEOUT_MS=10000
JOB_POLL_INTERVAL_MS=2000
JOB_STALE_MINUTES=15
